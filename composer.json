{
  "name": "revkeen/sdk-php",
  "description": "Official PHP SDK for the RevKeen payments and billing API.",
  "keywords": [
    "revkeen",
    "payments",
    "billing",
    "subscriptions",
    "invoices",
    "php",
    "sdk",
    "openapi"
  ],
  "homepage": "https://docs.revkeen.com/docs/sdks/php",
  "license": "MIT",
  "authors": [
    {
      "name": "RevKeen",
      "homepage": "https://revkeen.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^8.0 || ^9.0",
    "friendsofphp/php-cs-fixer": "3.95.18"
  },
  "autoload": {
    "psr-4": {
      "RevKeen\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RevKeen\\Test\\": "test/"
    }
  },
  "support": {
    "docs": "https://docs.revkeen.com/docs/sdks/php",
    "source": "https://github.com/RevKeen/sdk-php",
    "issues": "https://github.com/RevKeen/sdk-php/issues"
  },
  "version": "1.20261006.2"
}
